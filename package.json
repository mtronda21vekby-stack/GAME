{
  "name": "blackcrown-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "type": "module",
  "scripts": {
    "dev": "corepack pnpm -r --parallel --if-present dev",
    "build:site": "corepack pnpm --filter @blackcrown/site build",
    "build:game": "corepack pnpm --filter @blackcrown/game build",
    "build:lobby": "corepack pnpm --filter @blackcrown/lobby build",
    "build:escape": "corepack pnpm exec vite build apps/escape",
    "build": "npm run build:site && npm run build:game && npm run build:lobby && npm run build:quiet-valley && npm run build:escape",
    "assemble": "node scripts/assemble.mjs",
    "build:prod": "npm run build && npm run assemble",
    "dev:site": "corepack pnpm --filter @blackcrown/site dev",
    "dev:game": "corepack pnpm --filter @blackcrown/game dev",
    "dev:lobby": "corepack pnpm --filter @blackcrown/lobby dev",
    "dev:escape": "corepack pnpm exec vite apps/escape",
    "dev:ws": "corepack pnpm --dir apps/ws-lobby dev",
    "deploy:ws": "corepack pnpm --dir apps/ws-lobby deploy",
    "typecheck": "corepack pnpm -r --if-present typecheck && npm run typecheck:escape",
    "typecheck:escape": "corepack pnpm exec tsc -p apps/escape/tsconfig.json --noEmit",
    "lint": "corepack pnpm -r --if-present lint",
    "build:quiet-valley": "corepack pnpm --filter @blackcrown/quiet-valley build",
    "dev:quiet-valley": "corepack pnpm --filter @blackcrown/quiet-valley dev"
  },
  "devDependencies": {
    "@types/react": "^18.3.6",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.7"
  }
}
