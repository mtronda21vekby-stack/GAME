{
  "name": "@blackcrown/lobby",
  "private": true,
  "type": "module",
  "scripts": {
    "build:quiet-valley": "node world-runtimes/quiet-valley/build.mjs",
    "dev": "node world-runtimes/quiet-valley/build.mjs && vite",
